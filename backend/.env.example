# Base de données PostgreSQL
DATABASE_URL="postgresql://itsolutions:itsolutions@localhost:5433/itsolutions?schema=public"

# Serveur
PORT=4200
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentification
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Domaine de la plateforme
PLATFORM_DOMAIN=itsolutions.tld

# Adresse du serveur VPN que les routeurs MikroTik doivent joindre (L2TP)
# (connect-to du script + identifiants VPN en base)
VPN_SERVER=vpn.itsolutions.tld

# Secret partagé IPsec du tunnel L2TP/IPsec.
# Vide = L2TP seul (non chiffré). Renseigné = le script intègre l'IPsec
# (ipsec-secret natif sur RouterOS 7.10+, peer IPsec manuel sur 6.x-7.9).
VPN_IPSEC_SECRET=

# SMTP (notifications email) - stub en développement
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ITSOLUTIONS <no-reply@itsolutions.tld>

# WhatsApp (notifications) - désactivé sans numéro
WHATSAPP_DISABLED=true

# FreeRADIUS
RADIUS_SERVER=127.0.0.1
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET=testing123
RADIUS_NAS_SECRET=nassecret123

# FreeRADIUS config paths (si FreeRADIUS est sur la même machine)
FREERADIUS_CLIENTS_CONF=/etc/freeradius/3.0/clients.conf
FREERADIUS_MODS_SQL=/etc/freeradius/3.0/mods-enabled/sql

# Webhook paiements
PAYMENT_WEBHOOK_SECRET=change-me-in-production
